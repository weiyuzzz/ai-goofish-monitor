################################################################################
# 🚀 1. 必填核心配置 (AI 模型)
# 只有配置了 AI，本项目才能实现智能分析。建议优先完成此处配置。
################################################################################

# 模型的 API Key。
OPENAI_API_KEY=sk-...

# 模型的 API 接口地址。
# 这里需要填写服务商提供的、兼容 OpenAI 格式的 API 地址。
# 例如: https://api.openai.com/v1/ 或国内大模型厂商提供的地址。
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1/

# 使用的模型名称。
# 注意：该模型必须支持图片分析功能 (Vision)。
OPENAI_MODEL_NAME=XiaomiMiMo/MiMo-V2-Flash


################################################################################
# 🖥️ 2. Web 管理界面配置
# 用于访问控制台，保护你的配置不被他人篡改。
################################################################################

# 服务运行端口 (默认 8000)
SERVER_PORT=8000

# 管理员账号与密码 (默认 admin / admin123)
WEB_USERNAME=admin
WEB_PASSWORD=admin123


################################################################################
# 🕷️ 3. 爬虫基础设置
# 控制浏览器的运行行为。
################################################################################

# 爬虫是否以无头模式运行 (默认 true)。
# 注意：使用 Docker 部署时必须设为 true。
RUN_HEADLESS=true

# 是否使用 Edge 浏览器内核 (默认 false, 即使用 Chrome)。
# 仅影响本地浏览器通道；Docker 镜像未内置 Edge，容器内会固定使用 Chromium。
LOGIN_IS_EDGE=false

# 是否开启自动转换：将电脑端链接转换为手机端链接 (建议开启)
PCURL_TO_MOBILE=true


################################################################################
# 🛠️ 4. AI 策略与兼容性 (可选)
# 如果你发现 AI 分析不准确或报错，请尝试调整此处。
################################################################################

# AI 调试模式 (默认 false)。开启后控制台会打印详细的 AI 分析日志。
AI_DEBUG_MODE=false

# (可选) 为 AI 请求配置 HTTP/S 代理。支持 http 和 socks5。
# 例如: http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
PROXY_URL=""

# 是否启用 enable_thinking 参数 (某些模型如 DeepSeek 可能需要，默认 false)
ENABLE_THINKING=false

# 是否启用 response_format (默认 true)。
# 豆包模型等不支持 json_object 格式的需设为 false；Gemini/GPT 等建议设为 true。
ENABLE_RESPONSE_FORMAT=true


################################################################################
# 📢 5. 消息推送配置 (可选)
# 只要配置其中一个即可收到通知。
################################################################################

# --- 平台推送开关 ---
# 闲鱼与孔夫子互相独立：打开哪个就推送哪个，两个都打开则两个都推送。
NOTIFY_XIANYU=true
NOTIFY_KONGFZ=true

# --- ntfy (推荐) ---
NTFY_TOPIC_URL=

# --- PushPlus (微信推送) ---
# 获取 token 访问 https://www.pushplus.plus
PUSHPLUS_TOKEN=
# 群组编码，不填仅发送给自己
PUSHPLUS_TOPIC=

# --- Bark (iOS 推荐) ---
# 例如: https://api.day.app/your_key
BARK_URL=

# --- 企业微信机器人 ---
WX_BOT_URL=

# --- Telegram 机器人 ---
# 获取 Token 找 @BotFather，获取 Chat ID 找 @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 可选：Telegram Bot API 反代地址，默认 https://api.telegram.org
TELEGRAM_API_BASE_URL=

# --- Gotify ---
GOTIFY_URL=
GOTIFY_TOKEN=

# --- 通用 Webhook ---
WEBHOOK_URL=
WEBHOOK_METHOD="POST"
WEBHOOK_CONTENT_TYPE="JSON"
WEBHOOK_HEADERS='{"X-API-TOKEN":"your-secret-token"}'
WEBHOOK_QUERY_PARAMETERS='{"title":"{{title}}","content":"{{content}}"}'
WEBHOOK_BODY='{"title":"{{title}}","content":"{{content}}"}'


################################################################################
# 🛡️ 6. 高级功能 (可选)
################################################################################

# --- 任务失败保护 ---
# 当任务持续失败(如 Cookie 失效)时，自动暂停避免风控。
TASK_FAILURE_THRESHOLD=3
TASK_FAILURE_PAUSE_SECONDS=86400
# 状态文件路径 (默认 logs/task-failure-guard.json)
TASK_FAILURE_GUARD_PATH=

# --- 任务运行日志清理 ---
# 启动时自动清理 logs/*.log 中超过保留天数的历史日志（默认 7 天）
TASK_LOG_RETENTION_DAYS=7

# --- 代理池轮换 ---
PROXY_ROTATION_ENABLED=false
# per_task 或 on_failure
PROXY_ROTATION_MODE="per_task"
PROXY_POOL=""
PROXY_ROTATION_RETRY_LIMIT=2
PROXY_BLACKLIST_TTL=300


################################################################################
# 📚 7. 孔夫子旧书网监控 (可选)
# 说明：孔夫子搜索接口需要登录态，请先在「孔夫子监控 → 账号配置」扫码登录。
# 未配置登录态时只能以游客模式短期访问，请求量上来后会被要求登录。
################################################################################

# 两次孔夫子请求之间的最小间隔（秒），默认 3，用于礼貌限速。
KONGFZ_REQUEST_INTERVAL=3
# 间隔之上的随机抖动上限（秒），默认 1。
KONGFZ_REQUEST_JITTER=1
# 单次请求超时（秒），默认 20。
KONGFZ_REQUEST_TIMEOUT=20
# 单个请求的最大重试次数，默认 3（指数退避）。
KONGFZ_REQUEST_RETRIES=3
# 可选：为孔夫子请求配置独立代理，例如 http://127.0.0.1:7890
KONGFZ_PROXY=""
# 可选：强制列表场景。keyword=官方关键词搜索（需登录，支持分页/筛选）；
# latest=最新上架（游客可短期访问）。留空时自动选择：有登录态用 keyword，否则 latest。
KONGFZ_LIST_SCENE=""
# 可选：收货地区编码（影响部分价格/库存展示），留空使用站点默认。
KONGFZ_USER_AREA=

# --- 反爬伪装（纯页面级动作，默认开启）---
# 会话预热：每轮先像人一样打开首页 → 搜索结果页，再调接口，使接口带真实 Referer 链与 cookie。
KONGFZ_WARMUP_ENABLED=true
# 诱饵动作：抓完后随机做 0~N 次“正常浏览”（商品页/首页/其它搜索页），只访问 HTML，绝不打接口。
KONGFZ_DECOY_ENABLED=true
KONGFZ_DECOY_MAX_ACTIONS=2
# 启动抖动（秒）：每轮开跑前随机等待 0~N 秒，打散“每次都在整点第 0 秒”的机器节奏。
KONGFZ_START_JITTER_SECONDS=20
# 游客会话 cookie 持久化文件（跨轮复用同一个会话，避免每轮都是全新访客）。
# 注意：必须放在 state/ 之外，否则会被"账号配置"当成登录态列出。
KONGFZ_COOKIE_FILE=data/kongfz_guest_cookies.json

# --- Playwright 备用获取模式 ---
# 开启后使用真实浏览器获取孔夫子数据（拦截页面 XHR 中的 JSON），
# 可有效绕过反爬虫检测。关闭时使用原有 HTTP 接口方式（默认）。
# 可在 Web UI「孔夫子监控」页面账号配置栏上方通过开关切换。
# 切换后将在下一次任务运行时生效（正在运行的任务不受影响）。
KONGFZ_USE_PLAYWRIGHT=false
# Playwright 浏览器是否无头模式（true=无头，false=有界面）
KONGFZ_PLAYWRIGHT_HEADLESS=true
# Playwright 浏览器操作超时秒数
KONGFZ_PLAYWRIGHT_TIMEOUT=30
# 预览接口最大并发浏览器数（默认 1，避免连点瞬间拉起多个浏览器打满资源）
KONGFZ_PREVIEW_MAX_CONCURRENT=1
# 预览接口两次调用之间的最小间隔秒数（默认 3，防止过于频繁）
KONGFZ_PREVIEW_MIN_INTERVAL=3
